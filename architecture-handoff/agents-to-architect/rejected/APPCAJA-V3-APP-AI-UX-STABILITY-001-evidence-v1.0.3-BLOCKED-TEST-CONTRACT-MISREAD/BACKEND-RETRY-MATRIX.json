{
  "vertical": "APP-AI-UX-STABILITY-001",
  "version": "v1.0.3",
  "backendRetry": {
    "implementation": "ai-advisor.service.ts",
    "maxAttempts": 3,
    "triggerCondition": "AI_ADVISOR_UNGROUNDED_NUMBER (and other isRecoverableAdvisorError codes)",
    "nonRetryableErrors": [
      "AI_ADVISOR_CONTEXT_TOO_LARGE",
      "AI_PROVIDER_ERROR",
      "AI_EXTRACTION_FAILED",
      "AI_OUTPUT_SCHEMA_INVALID",
      "SCANNED_PDF_NOT_SUPPORTED_YET",
      "VALIDATION_ERROR",
      "CARD_STATEMENT_IMPORT_ALREADY_RUNNING",
      "CARD_STATEMENT_DUPLICATE",
      "CARD_STATEMENT_HISTORY_CONFLICT"
    ],
    "preservation": {
      "range": "preserved exactly across attempts",
      "currency": "preserved exactly",
      "mode": "preserved exactly",
      "question": "preserved exactly",
      "fingerprint": "preserved exactly",
      "fingerprint_during_attempts": "context.fingerprint unchanged"
    },
    "feedbackOnRetry": {
      "feedbackMinimum": "include previousRejectedOutput issues in repairInstructions",
      "feedbackGranularity": "extracted validation issues, not full prompt or full response",
      "noSleepArbitrary": true
    },
    "timeBudgetMs": 120000,
    "identifierGeneration": {
      "providerRequestId": "generated per attempt by provider",
      "attemptId": "1 | 2 | 3",
      "correlationId": "generated once at start, same across all attempts"
    },
    "persistence": {
      "noPersistenceOnReject": true,
      "singleInteractionOnSuccess": true,
      "422OnExhaustion": {
        "code": "AI_ADVISOR_UNGROUNDED_NUMBER",
        "message": "lastError.message",
        "recoverable": true,
        "attemptCount": "attempts.length",
        "correlationId": "shared correlation ID"
      }
    }
  },
  "frontendContract": {
    "oneHttpCallPerUserAction": true,
    "frontendRetriesHidden": false,
    "loadingAlwaysTerminates": true,
    "clientTimeoutMs": 120000,
    "structured422Visible": true,
    "manualRetryOnly": true,
    "lateResponseNoReplacement": true,
    "fingerprintClaimsCitationsPreserved": true
  },
  "tests": {
    "test1": "attempt 1 invalid by ungrounded number, attempt 2 valid: 1 interaction persisted",
    "test2": "3 attempts invalid: 422 structured, 0 valid interactions",
    "test3": "non-recoverable error: 1 attempt only",
    "test4": "same fingerprint and sources across attempts",
    "test5": "different attempt IDs, single correlation ID",
    "test6": "max 3 attempts, never exceeded",
    "test7": "validator not relaxed across attempts"
  }
}
