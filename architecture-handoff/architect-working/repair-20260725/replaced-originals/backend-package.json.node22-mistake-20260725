{
  "name": "cajaapp-v3-backend",
  "version": "1.0.0",
  "description": "Backend for CajaApp V3 - Card PDF import with AI extraction",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "test": "vitest run --no-file-parallelism",
    "test:watch": "vitest",
    "repair:projection-rowids": "tsx src/scripts/repair-legacy-projection-rowids.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "check": "npm run build && npm run test",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:status": "prisma migrate status"
  },
  "keywords": [
    "cajaapp",
    "backend",
    "pdf",
    "ai",
    "ollama"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/multipart": "^9.0.0",
    "@fastify/swagger": "^9.0.0",
    "@fastify/swagger-ui": "^5.0.1",
    "@prisma/client": "^6.5.0",
    "canvas": "^3.2.3",
    "crypto-js": "^4.2.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "fastify-plugin": "^5.0.1",
    "pdf2pic": "^3.2.0",
    "pdfjs-dist": "^4.10.38",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^22.0.0",
    "prisma": "^6.5.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.4"
  },
  "engines": {
    "node": "22.x"
  }
}
