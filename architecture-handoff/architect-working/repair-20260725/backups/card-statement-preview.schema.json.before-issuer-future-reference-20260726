{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CardStatementPreview",
  "description": "Schema for card statement preview - what frontend receives for review",
  "type": "object",
  "required": ["statementId", "source", "summary", "sections", "groups", "rows", "futureInstallmentsBlock"],
  "properties": {
    "statementId": {
      "type": ["string", "null"]
    },
    "source": {
      "type": "object",
      "properties": {
        "bankName": { "type": ["string", "null"] },
        "brand": { "type": ["string", "null"] },
        "statementNumber": { "type": ["string", "null"] },
        "pageCount": { "type": "number" }
      }
    },
    "summary": {
      "type": "object",
      "properties": {
        "totalPesos": { "type": ["string", "null"] },
        "totalDollars": { "type": ["string", "null"] },
        "minimumPaymentPesos": { "type": ["string", "null"] },
        "currentDueDate": { "type": ["string", "null"] },
        "nextClosingDate": { "type": ["string", "null"] },
        "nextDueDate": { "type": ["string", "null"] }
      }
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "displayOrder": { "type": "number" },
          "label": { "type": "string" }
        }
      }
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "displayOrder": { "type": "number" },
          "label": { "type": "string" },
          "cardLast4": { "type": ["string", "null"] },
          "holderName": { "type": ["string", "null"] }
        }
      }
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "futureInstallmentsBlock": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  }
}
