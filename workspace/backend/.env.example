NODE_ENV=development
PORT=11436
HOST=127.0.0.1
DATABASE_URL=file:./dev.db
STORAGE_DIR=./storage
MAX_UPLOAD_BYTES=10485760

# Provider activo: ollama | openai-compatible
AI_PROVIDER=ollama

# Ollama API nativa
OLLAMA_MODE=local-proxy
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_API_KEY=
OLLAMA_MODEL=gemma4:31b-cloud
# 0 = sin timeout de respuesta impuesto por CajaApp
OLLAMA_TIMEOUT_MS=0
OLLAMA_MAX_RETRIES=0
OLLAMA_PREFLIGHT_ENABLED=true
OLLAMA_PREFLIGHT_TIMEOUT_MS=15000
OLLAMA_HEARTBEAT_INTERVAL_MS=10000
OLLAMA_KEEP_ALIVE=5m
OLLAMA_THINK=false
OLLAMA_STRUCTURED_OUTPUT=none
# Contexto máximo solicitado a Ollama
OLLAMA_NUM_CTX=256000

# Proveedor alternativo OpenAI-compatible.
AI_BASE_URL=
AI_CHAT_COMPLETIONS_PATH=/chat/completions
AI_API_KEY=
AI_MODEL=
# 0 = sin timeout de respuesta impuesto por CajaApp
AI_TIMEOUT_MS=0
# 0 = no enviar max_tokens/max_completion_tokens/num_predict
AI_MAX_OUTPUT_TOKENS=0
AI_TEMPERATURE=0
AI_TOKEN_PARAMETER=max_tokens
AI_RESPONSE_FORMAT=none

# Supervisión del worker. 0 = sin timeout total del job de IA.
AI_JOB_TIMEOUT_MS=0
# Este valor sólo permite recuperar jobs huérfanos tras una interrupción; no cancela un worker activo.
AI_PROCESSING_STALE_AFTER_MS=2100000
AI_WORKER_POLL_INTERVAL_MS=2000

# Extracción RAW
PYTHON_EXECUTABLE=.venv\Scripts\python.exe
PDF_RAW_EXTRACTOR_SCRIPT=python\pdf_to_raw.py
PDF_RAW_EXTRACTION_TIMEOUT_MS=60000
PDF_RAW_MAX_OUTPUT_BYTES=8000000
PDF_RAW_MAX_CHARACTERS=250000

CARD_STATEMENT_PROMPTS_DIR=../../contracts/prompts/cards
CARD_STATEMENT_SCHEMAS_DIR=../../contracts/schemas/cards
AI_MOCK_MODE=false
AI_DEBUG_CAPTURE_OLLAMA_REQUEST=false
