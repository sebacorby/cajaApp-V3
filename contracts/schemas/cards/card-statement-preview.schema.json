{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CardStatementPreview",
  "description": "Schema for card statement preview - what frontend receives for review",
  "type": "object",
  "required": ["statementId", "source", "summary", "sections", "groups", "rows", "futureInstallmentsBlock"],
  "properties": {
    "statementId": { "type": ["string", "null"] },
    "source": {
      "type": "object",
      "properties": {
        "bankName": { "type": ["string", "null"] },
        "brand": { "type": ["string", "null"] },
        "statementNumber": { "type": ["string", "null"] },
        "pageCount": { "type": "number" }
      }
    },
    "summary": {
      "type": "object",
      "properties": {
        "totalPesos": { "type": ["string", "null"] },
        "totalDollars": { "type": ["string", "null"] },
        "minimumPaymentPesos": { "type": ["string", "null"] },
        "currentDueDate": { "type": ["string", "null"] },
        "nextClosingDate": { "type": ["string", "null"] },
        "nextDueDate": { "type": ["string", "null"] }
      }
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "displayOrder": { "type": "number" },
          "label": { "type": "string" }
        }
      }
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "displayOrder": { "type": "number" },
          "label": { "type": "string" },
          "cardLast4": { "type": ["string", "null"] },
          "holderName": { "type": ["string", "null"] }
        }
      }
    },
    "rows": {
      "type": "array",
      "items": { "type": "object" }
    },
    "futureInstallmentsBlock": {
      "type": "array",
      "description": "Issuer-provided future installment reference retained separately from CajaApp projections.",
      "items": {
        "type": "object",
        "required": ["id", "displayOrder", "sourcePage", "sectionId", "sectionLabel", "groupId", "groupLabel", "groupOrder", "rowType", "editable", "dateRaw", "dateIso", "markerRaw", "referenceRaw", "installmentRaw", "installmentCurrent", "installmentTotal", "receiptRaw", "amountPesos", "amountDollars", "currencyOriginal", "originalText", "confidence", "warnings"],
        "properties": {
          "id": { "type": "string" },
          "displayOrder": { "type": "number" },
          "sourcePage": { "type": ["number", "null"] },
          "sectionId": { "type": "string" },
          "sectionLabel": { "type": "string" },
          "groupId": { "type": "null" },
          "groupLabel": { "type": "null" },
          "groupOrder": { "type": "null" },
          "rowType": { "const": "future_installment_reference" },
          "editable": { "const": false },
          "dateRaw": { "type": ["string", "null"] },
          "dateIso": { "type": ["string", "null"] },
          "markerRaw": { "type": ["string", "null"] },
          "referenceRaw": { "type": ["string", "null"] },
          "installmentRaw": { "type": ["string", "null"] },
          "installmentCurrent": { "type": ["number", "null"] },
          "installmentTotal": { "type": ["number", "null"] },
          "receiptRaw": { "type": ["string", "null"] },
          "amountPesos": { "type": ["string", "null"] },
          "amountDollars": { "type": ["string", "null"] },
          "currencyOriginal": { "type": "string", "enum": ["ARS", "USD", "MIXED", "UNKNOWN"] },
          "originalText": { "type": "string" },
          "confidence": { "type": ["number", "null"] },
          "warnings": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
