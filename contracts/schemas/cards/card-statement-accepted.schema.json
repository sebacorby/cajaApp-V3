{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CardStatementAccepted",
  "description": "Schema for accepted card statement - persisted after user accepts",
  "type": "object",
  "required": ["id", "status", "acceptedAt", "source", "summary", "sections", "groups", "rows", "projections"],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "status": {
      "type": "string",
      "const": "accepted"
    },
    "acceptedAt": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "object",
      "properties": {
        "bankName": { "type": ["string", "null"] },
        "brand": { "type": ["string", "null"] },
        "statementNumber": { "type": ["string", "null"] },
        "pageCount": { "type": "number" }
      }
    },
    "summary": {
      "type": "object",
      "properties": {
        "totalPesos": { "type": ["string", "null"] },
        "totalDollars": { "type": ["string", "null"] },
        "minimumPaymentPesos": { "type": ["string", "null"] },
        "currentDueDate": { "type": ["string", "null"] },
        "nextClosingDate": { "type": ["string", "null"] },
        "nextDueDate": { "type": ["string", "null"] }
      }
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "projections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "monthKey": { "type": "string" },
          "label": { "type": "string" },
          "totalPesos": { "type": "string" }
        }
      }
    }
  }
}
