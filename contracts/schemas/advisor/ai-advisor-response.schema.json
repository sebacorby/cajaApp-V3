{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cajaapp.local/schemas/advisor/ai-advisor-response.schema.json",
  "title": "CajaApp AI Advisor Response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "title",
    "answer",
    "confidence",
    "claims",
    "risks",
    "alternatives",
    "limitations",
    "followUpQuestions"
  ],
  "properties": {
    "schemaVersion": {
      "const": "advisor-response-v1.0.0"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 180
    },
    "answer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "confidence": {
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "$ref": "#/$defs/claim"
      }
    },
    "risks": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "$ref": "#/$defs/risk"
      }
    },
    "alternatives": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "$ref": "#/$defs/alternative"
      }
    },
    "limitations": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "followUpQuestions": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 220
      }
    }
  },
  "$defs": {
    "sourceIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text",
        "kind",
        "sourceIds"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "kind": {
          "enum": [
            "fact",
            "inference",
            "simulation"
          ]
        },
        "sourceIds": {
          "$ref": "#/$defs/sourceIds"
        }
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "explanation",
        "severity",
        "sourceIds"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "explanation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 800
        },
        "severity": {
          "enum": [
            "info",
            "attention"
          ]
        },
        "sourceIds": {
          "$ref": "#/$defs/sourceIds"
        }
      }
    },
    "alternative": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "description",
        "kind",
        "assumptions",
        "sourceIds"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 800
        },
        "kind": {
          "const": "simulation"
        },
        "assumptions": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          }
        },
        "sourceIds": {
          "$ref": "#/$defs/sourceIds"
        }
      }
    }
  }
}